# Copy this file to `deploy/lighthouse/.env` before running docker compose.
# This file is read by docker compose itself and is also passed to the backend container.

COMPOSE_PROJECT_NAME=gaokao-essay
API_DOMAIN=api.your-domain.com
BACKEND_IMAGE_NAME=gaokao-essay-backend
BACKEND_HOST_PORT=8080

GAOKAO_AUTH_TOKEN_SECRET=replace_with_a_long_random_secret_at_least_32_chars
GAOKAO_AUTH_TOKEN_EXPIRE_SECONDS=604800

GAOKAO_DATABASE_ENABLED=true
GAOKAO_DATABASE_URL=jdbc:postgresql://aws-REGION.pooler.supabase.com:5432/postgres?sslmode=require
GAOKAO_DATABASE_USERNAME=
GAOKAO_DATABASE_PASSWORD=
GAOKAO_DATABASE_DRIVER_CLASS_NAME=org.postgresql.Driver

GAOKAO_KNOWLEDGE_ENABLED=true
GAOKAO_LOCAL_AUTH_FALLBACK_ENABLED=false
GAOKAO_REQUEST_OPENID_FALLBACK_ENABLED=false
GAOKAO_BILLING_DEBUG_ENABLED=false
GAOKAO_STRICT_STARTUP_CHECKS=true
GAOKAO_MSG_SEC_ENABLED=true

WECHAT_APP_ID=
WECHAT_APP_SECRET=
WECHAT_STRICT_CODE2SESSION=true

GAOKAO_AI_BASE_URL=
GAOKAO_AI_API_KEY=
GAOKAO_AI_MODEL=
GAOKAO_AI_PROVIDER=openai-compatible
GAOKAO_AI_TEMPERATURE=0.7
GAOKAO_AI_TIMEOUT_SECONDS=90

GAOKAO_OCR_ENABLED=false
GAOKAO_OCR_BASE_URL=
GAOKAO_OCR_API_KEY=
GAOKAO_OCR_MODEL=
GAOKAO_OCR_PROVIDER=openai-compatible
# For Umi-OCR on the same Lighthouse server:
# GAOKAO_OCR_ENABLED=true
# GAOKAO_OCR_BASE_URL=http://127.0.0.1:1224
# GAOKAO_OCR_PROVIDER=umi-ocr
GAOKAO_OCR_TIMEOUT_SECONDS=90
GAOKAO_OCR_TENCENT_SECRET_ID=
GAOKAO_OCR_TENCENT_SECRET_KEY=
GAOKAO_OCR_TENCENT_REGION=
GAOKAO_OCR_TENCENT_ACTION=GeneralAccurateOCR
GAOKAO_OCR_TENCENT_VERSION=2018-11-19
GAOKAO_OCR_TENCENT_LANGUAGE_TYPE=zh

GAOKAO_TRIAL_TOTAL_LIMIT=0
GAOKAO_TRIAL_DAILY_LIMIT=5
GAOKAO_DEVICE_DAILY_LIMIT=4
GAOKAO_IP_DAILY_LIMIT=20
GAOKAO_REDIS_REQUIRED=true
GAOKAO_QUOTA_ZONE_ID=Asia/Shanghai
GAOKAO_AD_REWARD_ENABLED=true
GAOKAO_AD_REWARD_DAILY_LIMIT=5
GAOKAO_AD_REWARD_CREDIT_PER_VIEW=1
# A short-lived, one-time client completion claim is required before a reward is granted.
# This prevents empty direct calls but is not provider-verifiable proof of an ad view.
GAOKAO_AD_REWARD_CLAIM_NOT_BEFORE_SECONDS=3
GAOKAO_AD_REWARD_CLAIM_TTL_SECONDS=600

GAOKAO_PAYMENT_ENABLED=false
GAOKAO_PAYMENT_NOTIFY_URL=
GAOKAO_PAYMENT_CURRENCY=CNY
GAOKAO_PAYMENT_DESCRIPTION_PREFIX=高考英语作文会员

WECHAT_PAY_MERCHANT_ID=
WECHAT_PAY_MERCHANT_SERIAL_NUMBER=
WECHAT_PAY_PRIVATE_KEY_FILE=
WECHAT_PAY_PLATFORM_PUBLIC_KEY_FILE=
WECHAT_PAY_PLATFORM_SERIAL_NUMBER=
WECHAT_PAY_API_V3_KEY=
